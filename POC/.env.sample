# Safe reference only. Never commit populated environment files or secrets.
# The Python scripts read process environment variables; they do not load this
# file automatically. Set these values in PowerShell, a scheduler, or a secret
# manager before running the loader.

DEST_SQL_SERVER=YOUR_SQL_SERVER
DEST_SQL_DATABASE=YOUR_DATABASE
DEST_SQL_USERNAME=YOUR_SQL_USERNAME
DEST_SQL_PASSWORD=REPLACE_WITH_SECRET

SOURCE_SQL_SERVER=YOUR_SOURCE_SQL_SERVER
SOURCE_SQL_DATABASE=YOUR_SOURCE_DATABASE
SOURCE_FILE_PATH=\\your-file-server\share\inbound\sample.txt

GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_SECRET=REPLACE_WITH_SECRET
GRAPH_SENDER=etl-service@example.org
GRAPH_RECIPIENT=data-operations@example.org
