# Microsoft Graph authentication only. Never commit populated secrets.
# Copy this file to .env beside etl_config.yaml. The loader reads it
# automatically, while process/scheduler environment variables take precedence.
GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_SECRET=REPLACE_WITH_SECRET
